// ========== Supplier ==========

model Supplier {
    id                  String   @id // References User.id (String)
    type_id             String
    badge_id            String?
    national_id         String   @db.VarChar(191)
    synonyms            String?  @db.VarChar(191)
    tax_card            String   @db.VarChar(191)
    commercial_register String   @db.VarChar(191)
    is_approved         Boolean? @default(false)

    type      SupplierType?          @relation(fields: [type_id], references: [id])
    badge     SupplierBadge?         @relation(fields: [badge_id], references: [id])
    addresses SupplierStoreAddress[]
    products  Product[]
    contracts Contract[]
    stats     SupplierStat?
    // complaints            Complaint[]
    // handoverConfirmations SupplierHandoverConfirmation[]

    @@map("supplier")
}

model SupplierType {
    id          String     @id @default(uuid())
    name        String     @unique @db.VarChar(191)
    description String?    @db.VarChar(191)
    synonyms    String?    @db.VarChar(191)
    created_at  DateTime   @default(now())
    updated_at  DateTime   @updatedAt
    deleted_at  DateTime?
    suppliers   Supplier[]

    @@map("supplier_type")
}

model ProfileUpdateRequest {
    id         String        @id @default(uuid())
    user_id    String
    data       Json
    status     RequestStatus @default(PENDING)
    created_at DateTime      @default(now())
    updated_at DateTime      @updatedAt

    user User @relation(fields: [user_id], references: [id])

    @@map("profile_update_request")
}

model SupplierStoreAddress {
    id               String            @id @default(uuid())
    supplier_id      String
    address_line_1   String?           @db.VarChar(191)
    address_line_2   String?           @db.VarChar(191)
    city             String?           @db.VarChar(191)
    state            String?           @db.VarChar(191)
    country          String?           @default("Egypt") @db.VarChar(191)
    google_map_link  String?           @db.VarChar(191)
    latitude         Decimal?          @db.Decimal(10, 8)
    longitude        Decimal?          @db.Decimal(11, 8)
    contact_name     String?           @db.VarChar(191)
    contact_phone    String?           @db.VarChar(191)
    working_hours    Json?
    created_at       DateTime          @default(now())
    updated_at       DateTime          @updatedAt
    supplier         Supplier?         @relation(fields: [supplier_id], references: [id])
    // pickupAssignments OrderAssignment[] @relation("PickupAddress")
    orderAssignments OrderAssignment[]

    @@map("supplier_store_address")
}

model SupplierActivity {
    id                 String    @id @default(uuid())
    product_id         String?
    old_price_out_site Decimal?
    new_price_out_site Decimal?
    changed_by_id      String?
    change_reason      String?   @db.VarChar(191)
    created_at         DateTime  @default(now())
    updated_at         DateTime  @updatedAt
    deleted_at         DateTime?
    product            Product?  @relation(fields: [product_id], references: [id])

    @@map("supplier_activity")
}

model SupplierStat {
    supplier_id            String    @id
    total_customers        Int?
    total_orders           Int?
    total_delivered_orders Int?
    total_cancelled_orders Int?
    total_active_products  Int?
    last_order_date        DateTime?
    category_stat          Json?
    brand_stat             Json?
    total_products_rating  Json?
    sales_history          Json?
    created_at             DateTime  @default(now())
    updated_at             DateTime  @updatedAt
    supplier               Supplier  @relation(fields: [supplier_id], references: [id])

    @@map("supplier_stat")
}

model SupplierBadge {
    id               String     @id @default(uuid())
    name             String     @unique @db.VarChar(191)
    description      String?    @db.Text
    min_value        Decimal?
    max_value        Decimal?
    visibility_score Decimal?
    suppliers        Supplier[]
    ads              Ad[]

    @@map("supplier_badge")
}

// Product & Categories

model Category {
    id                 Int             @id @default(autoincrement())
    name               String          @unique
    name_ar            String?
    description        String?         @db.LongText
    description_ar     String?         @db.LongText
    image_url          String?
    icon_url           String?
    parent_id          Int?
    is_active          Boolean
    product_attributes String?         @db.LongText
    created_at         DateTime        @default(now())
    updated_at         DateTime        @updatedAt
    sort_id            Int             @default(0)
    deleted_at         DateTime?
    slug               String?         @unique
    synonyms           String?
    brandCategories    BrandCategory[]
    category           Category?       @relation("categoryTocategory", fields: [parent_id], references: [id])
    other_category     Category[]      @relation("categoryTocategory")
    products           Product[]

    @@index([sort_id], map: "categories_sortId_idx")
    @@index([parent_id])
    @@fulltext([name, name_ar, description, description_ar], map: "categories_name_nameAr_description_descriptionAr_idx")
    @@map("category")
}

model BrandCategory {
    id          Int      @id @default(autoincrement())
    brand_id    Int
    category_id Int
    created_at  DateTime @default(now())
    brand       Brand    @relation(fields: [brand_id], references: [id], onDelete: Cascade)
    category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

    @@unique([brand_id, category_id])
    @@index([category_id], map: "brand_categories_categoryId_fkey")
    @@map("brand_category")
}

model Brand {
    id              Int             @id @default(autoincrement())
    name            String          @unique
    slug            String          @unique
    name_ar         String?
    logo_url        String?
    cover_url       String?
    is_active       Boolean         @default(true)
    is_popular      Boolean         @default(false)
    created_at      DateTime        @default(now())
    updated_at      DateTime        @updatedAt
    description     String?         @db.LongText
    description_ar  String?         @db.LongText
    up_to           Int?
    sort_id         Int             @default(0)
    deleted_at      DateTime?
    synonyms        String?
    brandCategories BrandCategory[]
    products        Product[]

    @@index([sort_id])
    @@fulltext([name, name_ar, synonyms, description, description_ar])
    @@map("brand")
}

model Product {
    id                               String             @id @default(uuid())
    name                             String
    name_ar                          String?
    description                      String?            @db.LongText
    description_ar                   String?            @db.LongText
    price                            Float?
    cost_price                       Float?
    stock                            Int                @default(0)
    min_stock                        Int                @default(5)
    sku                              String             @unique
    barcode                          String?            @unique
    images                           String?            @db.LongText
    weight                           Float?
    dimensions                       String?
    is_active                        Boolean            @default(true)
    is_featured                      Boolean            @default(false)
    offer                            Float?
    category_id                      Int
    supplier_id                      String?
    brand_id                         Int?
    created_at                       DateTime           @default(now())
    updated_at                       DateTime           @updatedAt
    rating                           Float?             @default(0)
    total_reviews                    Int                @default(0)
    offer_valid_from                 DateTime?
    offer_valid_to                   DateTime?
    is_best_seller                   Boolean            @default(false)
    sort_id                          Int                @default(0)
    color                            String?
    deleted_at                       DateTime?
    discount_type                    DiscountType?
    discount_value_part_for_company  Decimal?
    discount_value_part_for_customer Decimal?
    discount_value_part_for_offers   Decimal?
    discount_value_total             Decimal?
    max_amount_for_one_order         Decimal?
    max_amount_for_one_user          Decimal?
    min_amount_for_one_order         Decimal?
    min_amount_for_one_user          Decimal?
    min_discount_rate                Decimal?
    price_out_site                   Decimal?
    refund_policy                    String?            @db.Text
    refundable                       Boolean?
    refundable_period                Decimal?
    reserved_in_carts_amount         Decimal?
    slug                             String?            @unique
    synonyms                         String?
    cartItems                        CartItem[]
    offers                           Offer[]
    order_items                      order_items[]
    brand                            Brand?             @relation(fields: [brand_id], references: [id])
    category                         Category           @relation(fields: [category_id], references: [id])
    supplier                         Supplier?          @relation(fields: [supplier_id], references: [id])
    product_attribute                ProductAttribute[]
    product_unit                     ProductUnit[]
    reviews                          reviews[]
    wishlist_items                   wishlist_items[]
    supplierActivities               SupplierActivity[]

    @@index([brand_id])
    @@index([category_id])
    @@index([supplier_id])
    @@index([sort_id])
    @@fulltext([name, name_ar, description, description_ar])
    @@map("product")
}

model ProductAttribute {
    id         Int     @id @default(autoincrement())
    key        String
    value      String
    product_id String
    value_ar   String?
    product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)

    @@unique([product_id, key])
    @@index([product_id], map: "product_attribute_product_id_fkey")
    @@map("product_attribute")
}

model ProductUnit {
    id             Int        @id @default(autoincrement())
    name           String
    price          Decimal
    description    String?
    description_ar String?
    name_ar        String?
    product_id     String
    cart_item      CartItem[]
    product        Product    @relation(fields: [product_id], references: [id])

    @@index([product_id], map: "product_unit_product_id_fkey")
    @@map("product_unit")
}

model Colors {
    id   String @id
    name String @db.VarChar(100)
    code String @db.VarChar(7)
}

model Offer {
    id                       Int            @id @default(autoincrement())
    product_id               String?
    target_customer_badge_id Int?
    offer_type               String?
    offer_value              Decimal?
    start_date               DateTime?      @db.Date
    end_date                 DateTime?      @db.Date
    is_active                Boolean?       @default(true)
    synonyms                 String?
    created_at               DateTime       @default(now())
    updated_at               DateTime       @updatedAt
    customer_class_id        Int?
    cartItems                CartItem[]
    customer_class           CustomerClass? @relation(fields: [customer_class_id], references: [id])
    product                  Product?       @relation(fields: [product_id], references: [id])
    customerBadge            CustomerBadge? @relation(fields: [target_customer_badge_id], references: [id])
    order_items              order_items[]

    @@index([customer_class_id], map: "offer_customer_class_id_fkey")
    @@index([product_id], map: "offer_product_id_fkey")
    @@index([target_customer_badge_id], map: "offer_target_customer_badge_id_fkey")
    @@map("offer")
}

model Contract {
    id                 String          @id @default(uuid())
    supplier_id        String?
    details            String?         @db.VarChar(191)
    min_discount_ratio Decimal?
    max_discount_ratio Decimal?
    start_date         DateTime?       @db.Date
    end_date           DateTime?       @db.Date
    status             ContractStatus?
    created_at         DateTime        @default(now())
    updated_at         DateTime        @updatedAt
    deleted_at         DateTime?
    supplier           Supplier?       @relation(fields: [supplier_id], references: [id])

    @@map("contract")
}
