// ========== Payments ==========

model PaymentAttempt {
    id          Int                   @id @default(autoincrement())
    orderId     Int
    provider    String
    intentionId String?
    status      PaymentAttempt_status @default(PENDING)
    rawResponse String?               @db.LongText
    createdAt   DateTime              @default(now())
    orders      orders                @relation(fields: [orderId], references: [id])
    refunds     refunds[]

    @@index([intentionId])
    @@index([orderId])
}

model refund_items {
    id          Int         @id @default(autoincrement())
    refundId    Int
    orderItemId Int
    quantity    Int
    amount      Float
    order_items order_items @relation(fields: [orderItemId], references: [id])
    refunds     refunds     @relation(fields: [refundId], references: [id], onDelete: Cascade)

    @@unique([refundId, orderItemId])
    @@index([orderItemId], map: "refund_items_orderItemId_fkey")
}

model refunds {
    id                               Int             @id @default(autoincrement())
    orderId                          Int
    paymentAttemptId                 Int?
    amount                           Float
    currency                         String          @default("EGP")
    reason                           String?
    status                           refunds_status  @default(REQUESTED)
    provider                         String?
    providerRefundId                 String?
    rawResponse                      String?         @db.LongText
    requestedById                    String?
    reviewedById                     String?
    reviewedAt                       DateTime?
    createdAt                        DateTime        @default(now())
    updatedAt                        DateTime
    refund_items                     refund_items[]
    orders                           orders          @relation(fields: [orderId], references: [id])
    PaymentAttempt                   PaymentAttempt? @relation(fields: [paymentAttemptId], references: [id])
    user_refunds_requestedByIdTouser User?           @relation("refunds_requestedByIdTouser", fields: [requestedById], references: [id])
    user_refunds_reviewedByIdTouser  User?           @relation("refunds_reviewedByIdTouser", fields: [reviewedById], references: [id])

    @@index([orderId])
    @@index([paymentAttemptId], map: "refunds_paymentAttemptId_fkey")
    @@index([providerRefundId])
    @@index([requestedById])
    @@index([reviewedById])
}

