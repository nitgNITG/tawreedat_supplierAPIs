generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =========================================================
// Enums
// =========================================================

enum Gender {
  male
  female
}

enum DiscountType {
  percent
  fixed
}

enum ContractStatus {
  active
  completed
  cancelled
}

// =========================================================
// Models
// =========================================================

// ========== User ==========

model User {
  id                    String    @id @default(uuid())
  role_id               String
  full_name             String    @db.VarChar(191)
  email                 String    @unique @db.VarChar(191)
  phone                 String?   @unique @db.VarChar(191)
  password              String    @db.VarChar(191)
  image_url             String?   @db.VarChar(191)
  lang                  String?   @db.VarChar(191)
  last_login_at         String?   @db.VarChar(191)
  is_confirmed          Boolean?  @default(false)
  password_last_updated DateTime?
  birth_date            DateTime?
  gender                Gender?
  fcm_token             String?   @db.VarChar(191)
  login_type            String?   @db.VarChar(191)
  apple_id              String?   @db.VarChar(191)
  created_at            DateTime  @default(now())
  updated_at            DateTime  @updatedAt
  deleted_at            DateTime?

  role     UserRole? @relation(fields: [role_id], references: [id])
  supplier Supplier?

  @@map("user")
}

model UserRole {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(191)
  description String?   @db.VarChar(191)
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  deleted_at  DateTime?
  users       User[]

  @@map("user_role")
}

model UserVerify {
  id      String  @id @default(uuid())
  user_id String  @unique() @db.VarChar(191)
  email   String? @default(dbgenerated("NULL")) @db.VarChar(191)
  phone   String? @default(dbgenerated("NULL")) @db.VarChar(191)
  code    String? @db.VarChar(191)

  // New OTP Fields
  email_otp                String?   @default(dbgenerated("NULL")) @db.VarChar(191)
  email_otp_expired_at     DateTime? @default(dbgenerated("NULL"))
  password_otp             String?   @default(dbgenerated("NULL")) @db.VarChar(191)
  password_otp_expired_at  DateTime? @default(dbgenerated("NULL"))
  new_email                String?   @default(dbgenerated("NULL")) @db.VarChar(191)
  new_email_otp            String?   @default(dbgenerated("NULL")) @db.VarChar(191)
  new_email_otp_expired_at DateTime? @default(dbgenerated("NULL"))

  created_at DateTime  @default(now())
  updated_at DateTime? @updatedAt
  deleted_at DateTime?

  @@map("user_verify")
}

// ========== Supplier ==========

model Supplier {
  id                  String    @id // References User.id (String)
  type_id             String
  badges_id           String?
  national_id         String    @db.VarChar(191)
  synonyms            String?   @db.VarChar(191)
  tax_card            String    @db.VarChar(191)
  commercial_register String    @db.VarChar(191)
  is_approved         Boolean?  @default(false)
  is_active           Boolean?  @default(true)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  deleted_at          DateTime?

  user      User                   @relation(fields: [id], references: [id])
  type      SupplierType?          @relation(fields: [type_id], references: [id])
  badge     SupplierBadge?         @relation(fields: [badges_id], references: [id])
  addresses SupplierStoreAddress[]
  products  Product[]
  contracts Contract[]
  stats     SupplierStat?

  @@map("supplier")
}

model SupplierType {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(191)
  description String?    @db.VarChar(191)
  synonyms    String?    @db.VarChar(191)
  created_at  DateTime   @default(now())
  updated_at  DateTime   @updatedAt
  deleted_at  DateTime?
  suppliers   Supplier[]

  @@map("supplier_type")
}

model SupplierStoreAddress {
  id                 String    @id @default(uuid())
  supplier_id        String
  address_line_1     String?   @db.VarChar(191)
  address_line_2     String?   @db.VarChar(191)
  city               String?   @db.VarChar(191)
  state              String?   @db.VarChar(191)
  country            String?   @default("Egypt") @db.VarChar(191)
  postal_code        String?   @db.VarChar(191)
  latitude           Decimal?  @db.Decimal(10, 8)
  longitude          Decimal?  @db.Decimal(11, 8)
  contact_name       String?   @db.VarChar(191)
  contact_phone      String?   @db.VarChar(191)
  working_hours      Json?
  delivery_radius_km Decimal?
  covered_cities     Json?
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  supplier           Supplier? @relation(fields: [supplier_id], references: [id])

  @@map("supplier_store_address")
}

model SupplierActivity {
  id                 String    @id @default(uuid())
  product_id         String?
  old_price_out_site Decimal?
  new_price_out_site Decimal?
  changed_by_id      String?
  change_reason      String?   @db.VarChar(191)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
  deleted_at         DateTime?
  product            Product?  @relation(fields: [product_id], references: [id])

  @@map("supplier_activity")
}

model SupplierStat {
  supplier_id          String    @id
  total_contract_value Decimal?
  total_customers      Int?
  active_products      Int?
  total_orders         Int?
  delivered_orders     Int?
  cancelled_orders     Int?
  rating               Decimal?
  last_order_date      DateTime?
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  supplier             Supplier  @relation(fields: [supplier_id], references: [id])

  @@map("supplier_stat")
}

model SupplierBadge {
  id               String     @id @default(uuid())
  name             String     @db.VarChar(191)
  description      String?    @db.Text
  min_value        Decimal?
  max_value        Decimal?
  visibility_score Int?
  suppliers        Supplier[]

  @@map("supplier_badge")
}

// ========== Product & Categories ==========

model Category {
  id                 String   @id @default(uuid())
  parent_id          String?  @default(dbgenerated("NULL"))
  sort_id            Int      @default(0)
  name               String   @db.VarChar(191)
  name_ar            String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  description        String?  @default(dbgenerated("NULL")) @db.LongText
  description_ar     String?  @default(dbgenerated("NULL")) @db.LongText
  synonyms           String?  @db.VarChar(191)
  images_url         String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  icons_url          String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  is_active          Boolean  @default(true)
  product_attributes String?  @default(dbgenerated("NULL")) @db.LongText
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  brandCategories BrandCategory[]
  products        Product[]
  brands          Brand[]         @relation("CategoryBrands")

  @@map("category")
}

model BrandCategory {
  id          String   @id @default(uuid())
  brand_id    String
  category_id String
  created_at  DateTime @default(now())

  brand    Brand?    @relation(fields: [brand_id], references: [id])
  category Category? @relation(fields: [category_id], references: [id])

  @@map("brand_category")
}

model Brand {
  id             String   @id @default(uuid())
  category_id    String?
  name           String   @db.VarChar(191)
  name_ar        String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  description    String?  @default(dbgenerated("NULL")) @db.LongText
  description_ar String?  @default(dbgenerated("NULL")) @db.LongText
  synonyms       String?  @db.VarChar(191)
  logos_url      String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  covers_url     String?  @default(dbgenerated("NULL")) @db.VarChar(191)
  up_to          Int?     @default(dbgenerated("NULL"))
  is_popular     Boolean  @default(false)
  is_active      Boolean  @default(true)
  is_deleted     Boolean  @default(false)
  sort_id        Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  category        Category?       @relation("CategoryBrands", fields: [category_id], references: [id])
  brandCategories BrandCategory[]
  products        Product[]

  @@map("brand")
}

model Product {
  id                               String        @id @default(uuid())
  supplier_id                      String
  category_id                      String?
  brand_id                         String?
  unit_types                       String?
  name                             String        @db.VarChar(191)
  name_ar                          String?       @db.VarChar(191)
  description                      String?       @db.VarChar(191)
  description_ar                   String?       @db.VarChar(191)
  barcode                          String?       @db.VarChar(191)
  images_url                       String?       @db.VarChar(191)
  color                            String?       @db.VarChar(191)
  price_out_site                   Decimal?
  discount_type                    DiscountType?
  discount_value_total             Decimal?
  discount_value_part_for_customer Decimal?
  discount_value_part_for_company  Decimal?
  discount_value_part_for_offers   Decimal?
  available_amount                 Decimal?
  reserved_in_carts_amount         Decimal?
  ordered_amount                   Decimal?
  is_active                        Boolean?
  synonyms                         String?       @db.VarChar(191)
  min_discount_rate                Decimal?
  min_amount_for_one_user          Decimal?
  max_amount_for_one_user          Decimal?
  min_amount_for_one_order         Decimal?
  max_amount_for_one_order         Decimal?
  refundable                       Boolean?
  refundable_period                Decimal?
  refund_policy                    String?       @db.Text
  created_at                       DateTime      @default(now())
  updated_at                       DateTime      @updatedAt
  deleted_at                       DateTime?

  supplier   Supplier?          @relation(fields: [supplier_id], references: [id])
  category   Category?          @relation(fields: [category_id], references: [id])
  brand      Brand?             @relation(fields: [brand_id], references: [id])
  unit       ProductUnit?       @relation(fields: [unit_types], references: [id])
  offers     Offer[]
  activities SupplierActivity[]

  @@map("product")
}

model ProductAttribute {
  id         String  @id @default(uuid())
  key        String  @db.VarChar(191)
  value      String  @db.VarChar(191)
  product_id String  @db.VarChar(191)
  value_ar   String? @db.VarChar(191)

  @@map("product_attribute")
}

model ProductUnit {
  id             String    @id @default(uuid())
  name           String    @db.VarChar(191)
  price          Decimal?
  description    String?   @db.VarChar(191)
  description_ar String?   @db.VarChar(191)
  products       Product[]

  @@map("product_unit")
}

model Offer {
  id                       String    @id @default(uuid())
  product_id               String?
  target_customer_badge_id String?
  offer_type               String?   @db.VarChar(191)
  offer_value              Decimal?
  start_date               DateTime? @db.Date
  end_date                 DateTime? @db.Date
  is_active                Boolean?  @default(true)
  synonyms                 String?   @db.VarChar(191)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  product Product? @relation(fields: [product_id], references: [id])

  @@map("offer")
}

model Contract {
  id                 String          @id @default(uuid())
  supplier_id        String?
  details            String?         @db.VarChar(191)
  min_discount_ratio Decimal?
  max_discount_ratio Decimal?
  start_date         DateTime?       @db.Date
  end_date           DateTime?       @db.Date
  status             ContractStatus?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
  deleted_at         DateTime?
  supplier           Supplier?       @relation(fields: [supplier_id], references: [id])

  @@map("contract")
}
